---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const collections = ['fustes','configuracions','guies','gomes','noticies'] as const;
  const categoryMeta: Record<string, { label: string; title: string; description: string }> = {
    fustes: {
      label: 'Fustes de Tennis Taula',
      title: 'Fustes de Tennis Taula: Ofensives, Defensives i Allround · TTC',
      description: 'Guia completa de fustes de tennis taula: tipus, diferències entre ofensiva, defensiva i allround, i quin mànec triar. Anàlisi en català per a tots els nivells.'
    },
    configuracions: {
      label: 'Configuracions de Pales',
      title: 'Configuracions de Pales de Tennis Taula: Fustes + Gomes · TTC',
      description: 'Configuracions completes de pales de tennis taula per a jugadors de tots els nivells: fustes, gomes, estils ofensiu, defensiu i de control. Guies en català.'
    },
    guies: {
      label: 'Guies de Tennis Taula',
      title: 'Guies de Tennis Taula en Català: Materials, Regles i Consells · TTC',
      description: 'Guies pràctiques de tennis taula en català: com triar la teva pala, tipus de gomes i fustes, regles bàsiques i consells per millorar el teu joc. Per a tots els nivells.'
    },
    gomes: {
      label: 'Gomes de Tennis Taula',
      title: 'Gomes de Tennis Taula: Llises, Pics, Antispin i Antitop · TTC',
      description: 'Ressenyes i comparatives de gomes de tennis taula en català: gomes llises, de pics curts, pics llargs, antispin i antitop. Troba la goma adequada per al teu joc.'
    },
    noticies: {
      label: 'Notícies de Tennis Taula',
      title: 'Notícies de Tennis Taula a Catalunya: Tornejos i Resultats · TTC',
      description: 'Notícies de tennis taula a Catalunya: tornejos, competicions per equips, resultats i convocatòries de la selecció catalana. Actualitat del tennis taula català.'
    },
  };
  return await Promise.all(
    collections.map(async (col) => {
      const posts = await getCollection(col);
      return {
        params: { category: col },
        props: {
          posts: posts.filter((p: any) => !p.data.draft).sort((a: any,b: any) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()),
          collection: col,
          meta: categoryMeta[col]
        }
      };
    })
  );
}
const { posts, collection, meta } = Astro.props;
const siteUrl = 'https://www.tennistaulacatalunya.com';
const breadcrumb = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inici", "item": siteUrl + "/" },
    { "@type": "ListItem", "position": 2, "name": meta.label, "item": `${siteUrl}/${collection}/` }
  ]
};
---
<BaseLayout title={meta.title} description={meta.description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} slot="head" />
  <div class="cat-page">
    <div class="container">
      <div class="cat-header">
        <a href="/" class="breadcrumb">Inici</a><span> / </span><span>{meta.label}</span>
      </div>
      <h1 class="cat-title">{meta.label}</h1>
      <p class="cat-desc">{meta.description}</p>
      <div class="posts-count">{posts.length} articles</div>
      <div class="posts-grid">
        {posts.map((post: any) => <PostCard post={post} collection={collection} />)}
      </div>
    </div>
  </div>
</BaseLayout>
<style>
.cat-page { padding: 40px 0 80px; }
.cat-header { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 24px; }
.cat-header a:hover { color: var(--accent); }
.cat-title { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.03em; margin-bottom: 12px; }
.cat-desc { font-size: 1rem; color: var(--text-secondary); max-width: 560px; margin-bottom: 8px; }
.posts-count { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 40px; }
.posts-grid { display: grid; gap: 10px; }
</style>
