---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const collections = ['fustes','configuracions','guies','gomes','noticies'] as const;
const allPosts = (await Promise.all(
  collections.map(async (col) => {
    const posts = await getCollection(col);
    return posts.map(p => ({ ...p, collection: col }));
  })
)).flat().filter(p => !p.data.draft)
  .sort((a,b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const recentPosts = allPosts.slice(0, 8);

const categories = [
  { slug: 'fustes', label: 'Fustes', desc: 'Ofensives, defensives i allround', icon: '🪵' },
  { slug: 'gomes', label: 'Gomes', desc: 'Llises, pics, antispin i més', icon: '🏓' },
  { slug: 'configuracions', label: 'Configuracions', desc: 'Pales pro i amateur', icon: '⚙️' },
  { slug: 'guies', label: 'Guies', desc: 'Tot el que necessites saber', icon: '📖' },
  { slug: 'noticies', label: 'Notícies', desc: 'Tennis taula a Catalunya', icon: '📰' },
];
---
<BaseLayout
  title="Blog de Tennis Taula Catalunya · Fustes, Gomes i Guies"
  description="Tot sobre el tennis taula en català: anàlisi de fustes i gomes, configuracions de pales, guies per a tots els nivells i notícies de competicions catalanes."
>
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-label">Blog de tennis taula en català</div>
        <h1 class="hero-title">Material, tècnica<br/>i notícies de tennis taula</h1>
        <p class="hero-desc">Guies, ressenyes i anàlisis per a jugadors de tots els nivells. El teu blog de tennis taula en català.</p>
      </div>
    </div>
  </section>
  <section class="section-categories">
    <div class="container">
      <div class="categories-grid">
        {categories.map(cat => (
          <a href={`/${cat.slug}/`} class="cat-card">
            <span class="cat-icon">{cat.icon}</span>
            <div><strong>{cat.label}</strong><span>{cat.desc}</span></div>
            <span class="cat-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section-posts">
    <div class="container">
      <div class="section-header"><h2>Últimes entrades</h2></div>
      <div class="posts-grid">
        {recentPosts.map(post => <PostCard post={post} collection={post.collection} />)}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
.hero { padding: 72px 0 56px; border-bottom: 1px solid var(--border); background: linear-gradient(180deg, var(--bg) 0%, var(--bg-secondary) 100%); }
.hero-inner { max-width: 600px; }
.hero-label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); font-weight: 500; margin-bottom: 16px; }
.hero-title { font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1.08; letter-spacing: -0.03em; margin-bottom: 20px; }
.hero-desc { font-size: 1.05rem; color: var(--text-secondary); line-height: 1.6; max-width: 480px; }
.section-categories { padding: 48px 0; border-bottom: 1px solid var(--border); }
.categories-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
.cat-card { display: flex; align-items: center; gap: 14px; padding: 16px 20px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); transition: all 0.2s; }
.cat-card:hover { border-color: var(--accent); box-shadow: var(--shadow-sm); }
.cat-icon { font-size: 1.4rem; flex-shrink: 0; }
.cat-card div { flex: 1; }
.cat-card strong { display: block; font-size: 0.95rem; font-weight: 500; color: var(--text); }
.cat-card span { font-size: 0.82rem; color: var(--text-muted); }
.cat-arrow { color: var(--text-muted); transition: transform 0.15s, color 0.15s; }
.cat-card:hover .cat-arrow { transform: translateX(4px); color: var(--accent); }
.section-posts { padding: 56px 0 80px; }
.section-header { margin-bottom: 28px; padding-bottom: 16px; border-bottom: 1px solid var(--border); }
.section-header h2 { font-size: 1.4rem; }
.posts-grid { display: grid; gap: 10px; }
</style>
